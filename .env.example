# Copy to .env as needed. NEVER commit .env (AGENTS.md §12).

# Required in production; generated once by deploy/install.sh (Phase 6).
# Back it up — losing it loses every encrypted credential (AGENTS.md §4.6).
ENCRYPTION_KEY=

# Postgres connection string (used from Phase 1)
DATABASE_URL=postgres://agentflow:agentflow@localhost:5432/agentflow

# Redis (used from Phase 5)
REDIS_URL=redis://localhost:6379

# Internal URLs / ports
API_URL=http://localhost:3001

# LLM gateway — OpenAI-compatible endpoint (used from Phase 4).
# OmniRoute is bundled but not privileged; LLM_BASE_URL may point anywhere.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=
